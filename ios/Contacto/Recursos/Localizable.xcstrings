    "opiniones_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert etwas nicht, oder hast du eine Idee? Schreib uns. Wenn dir die App hilft, hilft eine Bewertung bei Google Play anderen, sie zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something not working, or an idea? Write to us. If the app helps you, a rating on Google Play helps others find it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo no funciona o tienes una idea? Escríbenos. Si la app te ayuda, valorarla en Google Play ayuda a que otros la encuentren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème ou une idée ? Écrivez-nous. Si l'appli vous aide, une note sur Google Play aide d'autres personnes à la trouver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то не работает или есть идея? Напишите нам. Если приложение помогает, оценка в Google Play поможет другим его найти."
          }
        }
      }
    },
    "pausa": {
      "localizations": {
