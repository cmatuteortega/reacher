    "bateria_autoarranque_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %1$@-Handys schalte außerdem den Autostart für Contacto ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ phones, also turn on autostart for Contacto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los teléfonos %1$@, activa también el inicio automático de Contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les téléphones %1$@, activez aussi le démarrage automatique de Contacto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефонах %1$@ включите также автозапуск для Contacto."
          }
        }
      }
    },
    "bateria_aviso_texto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Akku zu sparen, kann %1$@ Contacto schließen – dann kommen Erinnerungen zu spät oder gar nicht. Lass die App im Hintergrund laufen. Das geht auch später in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save battery, %1$@ may close Contacto, and then reminders arrive late or not at all. Let it run in the background. You can also do this later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ahorrar batería, %1$@ puede cerrar Contacto, y entonces los avisos llegan tarde o no llegan. Deja que funcione en segundo plano. También puedes hacerlo luego en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour économiser la batterie, %1$@ peut fermer Contacto : les rappels arrivent alors en retard, ou pas du tout. Laissez-la fonctionner en arrière-plan. Vous pourrez aussi le faire plus tard dans les Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы экономить заряд, %1$@ может закрывать Contacto, и тогда напоминания приходят с опозданием или не приходят вовсе. Разрешите приложению работать в фоне. Это можно сделать и позже в настройках."
          }
        }
      }
    },
    "bateria_aviso_titulo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Erinnerung verpassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't miss your reminders"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que no se pierdan los avisos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
