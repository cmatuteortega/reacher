    "ios_copia_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Leute und Einstellungen sind im Backup des iPhones. Um sie selbst umzuziehen, exportiere eine Datei und öffne sie auf dem anderen Telefon (geht auch mit der Android-App)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your people and settings go into your iPhone's backup. To move them yourself, export a file and open it on the other phone (it also works with the Android app)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gente y tus ajustes van en la copia de seguridad del iPhone. Para llevarlos tú mismo, exporta un archivo y ábrelo en el otro teléfono (también vale con la app de Android)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos proches et vos réglages sont inclus dans la sauvegarde de l'iPhone. Pour les déplacer vous-même, exportez un fichier et ouvrez-le sur l'autre téléphone (cela marche aussi avec l'app Android)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши люди и настройки входят в резервную копию iPhone. Чтобы перенести их самостоятельно, экспортируйте файл и откройте его на другом телефоне (подходит и для приложения на Android)."
          }
        }
      }
    },
