    "posponer_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommt nach %1$@ wieder; liegt das außerhalb der Erinnerungszeiten, um %2$@. Wischst du sie einfach weg, kommt sie am nächsten Tag wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes back after %1$@; if that's outside reminder hours, at %2$@. If you just dismiss it, it comes back the next day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al cabo de %1$@; si cae fuera del horario, a las %2$@. Si quitas el aviso sin más, vuelve al día siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il revient au bout de %1$@ ; si c'est en dehors des horaires, à %2$@. Si tu l'écartes simplement, il revient le lendemain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернётся через %1$@; если это вне времени напоминаний — в %2$@. Если просто смахнуть уведомление, оно вернётся на следующий день."
          }
        }
      }
    },
    "privacidad_estadisticas": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungsstatistiken teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share usage statistics"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir estadísticas de uso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager les statistiques d'utilisation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делиться статистикой использования"
          }
        }
      }
    },
    "privacidad_estadisticas_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Zählungen dessen, was genutzt wird, etwa wie oft Erinnerungen verschoben werden, um zu wissen, was sich verbessern lässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous counts of what gets used, such as how often reminders are snoozed, to know what to improve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuentos anónimos de lo que se usa, como cuántas veces se pospone un aviso, para saber qué mejorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des décomptes anonymes de ce qui est utilisé, comme la fréquence des rappels reportés, pour savoir quoi améliorer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимные подсчёты того, что используется, например как часто откладываются напоминания, чтобы понять, что улучшить."
          }
        }
      }
    },
    "privacidad_fallos": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absturzberichte senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send crash reports"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar informes de fallos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer les rapports de plantage"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять отчёты о сбоях"
          }
        }
      }
    },
    "privacidad_fallos_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die App abstürzt oder hängt, sendet sie einen anonymen technischen Bericht, damit der Fehler behoben werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app crashes or freezes, it sends an anonymous technical report so the problem can be fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app se cierra o se queda colgada, envía un informe técnico anónimo para poder arreglarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'app plante ou se fige, elle envoie un rapport technique anonyme pour que le problème soit corrigé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если приложение закроется или зависнет, оно отправит анонимный технический отчёт, чтобы проблему можно было исправить."
          }
        }
      }
    },
    "privacidad_nunca": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemals Namen, Nummern oder Notizen: Deine Leute bleiben auf deinem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never names, numbers or notes: your people stay on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca nombres, números ni notas: tu gente se queda en tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais de noms, de numéros ni de notes : vos proches restent sur votre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не имена, номера или заметки: ваши люди остаются на вашем телефоне."
          }
        }
      }
    },
