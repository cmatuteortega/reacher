    "anade_mas_texto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge noch jemanden hinzu oder mach weiter: Du kannst deinem System später jederzeit Leute hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add someone else or carry on: you can always add people to your system later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a alguien más o sigue: siempre podrás sumar gente a tu sistema después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute quelqu'un d'autre ou continue : tu pourras toujours agrandir ton système plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь ещё кого-нибудь или продолжай: людей в систему всегда можно добавить позже."
          }
        }
      }
    },
