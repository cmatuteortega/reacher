    "estadisticas_pregunta_texto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto kann anonyme Nutzungsstatistiken senden, etwa welche Bildschirme du nutzt oder wie oft du eine Erinnerung verschiebst. Niemals Namen, Nummern oder Notizen. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto can send anonymous usage statistics, such as which screens you use or how often you snooze a reminder. Never names, numbers or notes. You can change this anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto puede enviar estadísticas de uso anónimas, como qué pantallas usas o cuántas veces pospones un aviso. Nunca nombres, números ni notas. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto peut envoyer des statistiques d'utilisation anonymes, comme les écrans que vous utilisez ou la fréquence à laquelle vous reportez un rappel. Jamais de noms, de numéros ni de notes. Vous pouvez changer d'avis à tout moment dans les Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto может отправлять анонимную статистику использования, например какие экраны вы открываете или как часто откладываете напоминание. Никогда не имена, номера или заметки. Это можно изменить в любой момент в настройках."
          }
        }
      }
    },
    "estadisticas_pregunta_titulo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfst du, Contacto zu verbessern?"
