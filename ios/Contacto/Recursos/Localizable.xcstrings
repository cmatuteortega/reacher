    "bienvenida_horas_de_a": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erinnern dich von %1$@ bis %2$@. Zieh die Griffe um die Sonne, um das zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll remind you from %1$@ to %2$@. Drag the handles around the sun to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos de %1$@ a %2$@. Arrastra las asas alrededor del sol para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On te préviendra de %1$@ à %2$@. Fais glisser les poignées autour du soleil pour changer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы будем напоминать с %1$@ до %2$@. Перетащи ручки вокруг солнца, чтобы изменить."
          }
        }
      }
    },
    "bienvenida_horas_todo_el_dia": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erinnern dich zu jeder Tageszeit. Zieh die Griffe um die Sonne, um das zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll remind you at any time of day. Drag the handles around the sun to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos a cualquier hora. Arrastra las asas alrededor del sol para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On te préviendra à toute heure. Fais glisser les poignées autour du soleil pour changer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы будем напоминать в любое время. Перетащи ручки вокруг солнца, чтобы изменить."
          }
        }
      }
    },
    "bienvenida_sol_texto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dich kreisen die Menschen, die dir wichtig sind: Das ist dein System. Contacto erinnert dich, wenn es Zeit ist, jemanden anzurufen oder ihm zu schreiben, damit niemand aus deiner Umlaufbahn driftet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The people you care about revolve around you: they're your system. Contacto reminds you when it's time to call or message each of them, so no one drifts out of your orbit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A tu alrededor gira la gente que te importa: es tu sistema. Contacto te avisa cuando toca llamar o escribir a cada uno, para que nadie se aleje de tu órbita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes qui comptent pour toi gravitent autour de toi : c'est ton système. Contacto te prévient quand il est temps d'appeler ou d'écrire à chacune, pour que personne ne s'éloigne de ton orbite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вокруг тебя вращаются люди, которые тебе дороги: это твоя система. Contacto напомнит, когда пора позвонить или написать каждому, чтобы никто не сошёл с твоей орбиты."
          }
        }
      }
    },
    "bienvenida_sol_titulo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist die Sonne"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the sun"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú eres el sol"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es le soleil"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты — солнце"
          }
        }
      }
    },
