      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet die Erinnerung, auch wenn sie noch nicht fällig ist, auf demselben Weg wie die tägliche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the reminder even if it isn't due yet, the same way as the daily one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza el aviso aunque no toque todavía, por el mismo camino que el diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie le rappel même s'il n'est pas encore dû, par le même chemin que le quotidien."
