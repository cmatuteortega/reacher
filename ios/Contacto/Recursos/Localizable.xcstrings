    "eliminar_texto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person erscheint nicht mehr in der App und es gibt keine Erinnerungen mehr. In den Kontakten des Telefons wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll no longer appear in the app and there'll be no more reminders. Nothing is deleted from your phone's contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejará de salir en la app y no habrá más avisos. En la agenda del teléfono no se borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne n'apparaîtra plus dans l'app et il n'y aura plus de rappels. Rien n'est supprimé des contacts du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт пропадёт из приложения, и напоминаний больше не будет. В контактах телефона ничего не удалится."
          }
        }
      }
    },
