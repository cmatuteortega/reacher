    "horario_fuera": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Griffe am Ring entlang. Eine Erinnerung außerhalb wartet bis %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles around the ring. A reminder that falls outside waits until %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las asas por el anillo. Un aviso que caiga fuera espera a las %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les poignées sur l'anneau. Un rappel qui tombe en dehors attend %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигай ручки по кольцу. Напоминание вне этого времени подождёт до %1$@."
          }
        }
      }
    },
    "horario_juntas": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Griffe am Ring entlang. Übereinander: Erinnerungen zu jeder Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles around the ring. Together: reminders at any hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las asas por el anillo. Juntas: se avisa a cualquier hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les poignées sur l'anneau. Superposées : rappels à toute heure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигай ручки по кольцу. Вместе — напоминания в любое время."
          }
        }
      }
    },
