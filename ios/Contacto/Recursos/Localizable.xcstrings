    "bateria_restringida": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android schränkt Contacto im Hintergrund ein: Erinnerungen kommen womöglich nicht an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android has restricted Contacto in the background, so reminders may not arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tiene a Contacto restringida en segundo plano: puede que los avisos no lleguen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android limite Contacto en arrière-plan : les rappels risquent de ne pas arriver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ограничил работу Contacto в фоне: напоминания могут не приходить."
