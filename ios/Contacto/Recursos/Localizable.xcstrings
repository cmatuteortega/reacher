    "elige_a_alguien": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle jemanden aus, um die Details zu sehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick someone to see their details"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige a alguien para ver su ficha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quelqu'un pour voir sa fiche"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите человека, чтобы открыть карточку"
          }
        }
      }
    },
    "elige_agenda_texto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus deinen Kontakten jemanden, den du nicht aus den Augen verlieren willst, und er tritt in deine Umlaufbahn ein. In seinem Profil legst du fest, wie oft ihr euch meldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick someone from your contacts you don't want to lose touch with and they'll join your orbit. On their card you choose how often to talk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de tu agenda a quien no quieres perder de vista y entrará en tu órbita. En su ficha eliges cada cuántos días hablar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis dans tes contacts quelqu'un que tu ne veux pas perdre de vue : il entrera dans ton orbite. Sur sa fiche, tu choisis tous les combien de jours vous parler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери в контактах того, кого не хочешь терять из виду, и он выйдет на твою орбиту. В его карточке выбери, как часто общаться."
          }
        }
      }
    },
