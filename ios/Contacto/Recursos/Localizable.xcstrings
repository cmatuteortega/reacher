    "ios_privacidad_texto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto sendet nichts vom Telefon: keine Konten, kein Tracking, keine Statistiken. Deine Leute verlassen es nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto sends nothing off your phone: no accounts, no tracking, no analytics. Your people never leave it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto no manda nada fuera del teléfono: sin cuentas, sin rastreo, sin estadísticas. Tu gente no sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto n'envoie rien hors de votre téléphone : ni compte, ni suivi, ni statistiques. Vos proches n'en sortent jamais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto ничего не отправляет с телефона: ни аккаунтов, ни слежки, ни статистики. Ваши люди остаются на нём."
          }
        }
      }
    },
    "ios_resumen_categoria": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%u weitere von Contacto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%u more from Contacto"
          }
        },
        "es": {
