    "lista_vacia": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand in deiner Umlaufbahn.\nTippe auf + und wähle einen Kontakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one in your orbit yet.\nTap + and pick someone from your contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nadie en tu órbita.\nPulsa + y elige un contacto de tu agenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne dans ton orbite pour l'instant.\nTouche + et choisis un contact."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На твоей орбите пока никого.\nНажми + и выбери контакт."
          }
        }
      }
    },
    "listo_con_gente": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein System. Jetzt kannst du die App schließen und dein Leben genießen: Wir melden uns, wenn es Zeit ist, mit jemandem zu sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your system. Now you can close the app and get on with your life: we'll let you know when it's time to talk to each of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es tu sistema. Ahora puedes cerrar la app y seguir con tu vida: te avisaremos cuando toque hablar con cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici ton système. Tu peux maintenant fermer l'app et vivre ta vie : on te préviendra quand il sera temps de parler à chacun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это твоя система. Теперь можно закрыть приложение и жить своей жизнью: мы напомним, когда пора поговорить с каждым."
          }
        }
      }
    },
    "listo_sin_gente": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein System wartet: Wen du hinzufügst, tritt in deine Umlaufbahn ein. Wir melden uns, wenn es Zeit ist, mit jemandem zu sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your system is waiting: whoever you add will join your orbit. We'll let you know when it's time to talk to each of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sistema te espera: quien añadas entrará en tu órbita. Te avisaremos cuando toque hablar con cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton système t'attend : chaque personne ajoutée entrera dans ton orbite. On te préviendra quand il sera temps de parler à chacun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя система ждёт: каждый, кого добавишь, выйдет на твою орбиту. Мы напомним, когда пора поговорить с каждым."
          }
        }
      }
    },
    "manten_para_anotar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten zum Eintragen: heute angerufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to log: I called today"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén para anotar: he llamado hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens pour noter : appelé aujourd'hui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживай, чтобы отметить звонок"
          }
        }
      }
    },
    "medio_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Wird beim Hinzufügen vorgeschlagen; im Profil änderbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Suggested when you add someone; you can change it on their card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Se propone al añadir a alguien; en su ficha se puede cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Proposé quand tu ajoutes quelqu'un ; modifiable sur sa fiche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Предлагается при добавлении; можно изменить в карточке."
          }
        }
      }
    },
