    "notas_pista": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Merken: Namen der Kinder, worüber ihr gesprochen habt…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things to remember: their kids' names, what you talked about…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosas que recordar: cómo se llaman sus hijos, de qué hablasteis…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À retenir : le prénom de ses enfants, ce dont vous avez parlé…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что запомнить: как зовут детей, о чём говорили…"
          }
        }
