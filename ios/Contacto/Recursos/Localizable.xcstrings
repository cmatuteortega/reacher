    "bateria_libre": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto kann dich erinnern, auch wenn die App geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto can remind you even when it's closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto puede avisarte aunque esté cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto peut vous rappeler même lorsqu'elle est fermée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto может напоминать, даже когда приложение закрыто."
          }
        }
      }
    },
    "bateria_optimizada": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Energiesparmodus kann Erinnerungen verzögern oder blockieren. Lass Contacto im Hintergrund laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery saving can delay or block your reminders. Let Contacto run in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro de batería puede retrasar o bloquear los avisos. Deja que Contacto funcione en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'économie de batterie peut retarder ou bloquer les rappels. Laissez Contacto fonctionner en arrière-plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экономия заряда может задерживать или блокировать напоминания. Разрешите Contacto работать в фоне."
          }
        }
      }
    },
