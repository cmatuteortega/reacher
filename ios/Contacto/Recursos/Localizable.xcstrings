    "copia_explicacion": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Leute und Einstellungen sind in der Google-Sicherung des Handys enthalten. Um sie selbst umzuziehen, exportiere eine Datei und öffne sie auf dem anderen Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your people and settings go into your phone's Google backup. To move them yourself, export a file and open it on the other phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gente y tus ajustes van en la copia de Google del teléfono. Para pasarlos tú a mano, exporta un archivo y ábrelo en el otro teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos proches et vos réglages sont inclus dans la sauvegarde Google du téléphone. Pour les transférer vous-même, exportez un fichier et ouvrez-le sur l'autre téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши люди и настройки попадают в резервную копию Google на телефоне. Чтобы перенести их вручную, экспортируйте файл и откройте его на другом телефоне."
          }
        }
      }
    },
