    "ios_aviso_oculto": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand wartet auf ein Lebenszeichen von dir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone is waiting to hear from you"
          }
        },
