<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+: sin este permiso concedido las notificaciones no se ven. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Solo para la forma de contacto "Llamar directamente". Se pide al elegirla
      en la ficha; sin el, se abre el marcador. No exige tener telefonia: en una
      tableta el resto de opciones siguen valiendo.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
      Elegir contacto no necesita READ_CONTACTS: el selector se abre con
      ACTION_PICK sobre CommonDataKinds.Phone y el sistema concede lectura
      temporal SOLO de la fila elegida. El permiso es solo para la foto, que
      vive en otra fila; se pide desde la ficha y es opcional.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Solo para los informes de fallos (Sentry) y, si se aceptan, las
      estadisticas de uso (PostHog). Ver Telemetria.kt y la politica de privacidad.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vibraciones compuestas de las burbujas (choques con fuerza variable). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Copia de Android: solo la gente y los ajustes (ver res/xml/reglas_copia.xml).
      Ademas, en Ajustes se exporta e importa un archivo JSON a mano.
    -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/reglas_copia"
        android:fullBackupContent="@xml/copia_completa"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RecuerdaLlamar"
        tools:targetApi="33">

        <!-- Macrobenchmark mide la version publicada: tiene que poder perfilarla. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!-- Sentry arranca en Telemetria, y solo si el usuario no apago los informes. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!--
          singleTop: los enlaces del aviso, el widget y el atajo reusan la app
          abierta (onNewIntent). enableOnBackInvokedCallback de arriba activa el
          gesto atras predictivo (Android 13+).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RecuerdaLlamar.Arranque">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Enlaces contacto://... (ver Enlaces.kt). Sin BROWSABLE: solo los
              abren la propia app y el lanzador, no una pagina web.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="contacto" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/atajos" />
        </activity>

        <!--
          Trampolin de la notificacion: apunta el toque en la base de datos y
          abre la forma de contacto preferida. Es una Activity (sin interfaz) porque desde Android 12
          un BroadcastReceiver no puede lanzar actividades al pulsar una
          notificacion.
        -->
        <activity
            android:name=".NotificacionPulsadaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Botón "Más tarde" y aviso quitado de la bandeja. Solo lo llama la propia app. -->
        <receiver
            android:name=".avisos.AccionesAviso"
            android:exported="false" />

        <!-- Widget "Hoy toca". -->
        <receiver
            android:name=".widget.ReceptorWidgetHoy"
            android:exported="true"
            android:label="@string/widget_titulo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hoy" />
        </receiver>

        <!--
          Trampolines de Glance: solo se usan para acciones que no son
          actionStartActivity (callbacks, broadcasts, servicios). El widget solo
          abre actividades, que Glance lanza directas, asi que nunca las usamos.
          En EMUI (Honor/Huawei, Android 11) el sistema relanzaba la invisible
          sin su intent y la app se caia (IllegalArgumentException en
          launchTrampolineAction). Quitadas, ese relanzamiento falla fuera de
          nuestro proceso. Si el widget llega a usar otro tipo de accion,
          hay que quitar estas lineas.
        -->
        <activity
            android:name="androidx.glance.appwidget.action.ActionTrampolineActivity"
            tools:node="remove" />
        <activity
            android:name="androidx.glance.appwidget.action.InvisibleActionTrampolineActivity"
            tools:node="remove" />
    </application>
</manifest>
