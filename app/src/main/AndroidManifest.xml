<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: sin este permiso concedido las notificaciones no se ven. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Solo para la forma de contacto "Llamar directamente". Se pide al elegirla
      en la ficha; sin el, se abre el marcador. No exige tener telefonia: en una
      tableta el resto de opciones siguen valiendo.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
      Elegir contacto no necesita READ_CONTACTS: el selector se abre con
      ACTION_PICK sobre CommonDataKinds.Phone y el sistema concede lectura
      temporal SOLO de la fila elegida. El permiso es solo para la foto, que
      vive en otra fila; se pide desde la ficha y es opcional.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecuerdaLlamar">

        <!-- singleTop: "Cambie de idea" en el aviso reusa la app abierta (onNewIntent). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Trampolin de la notificacion: apunta el toque en la base de datos y
          abre la forma de contacto preferida. Es una Activity (sin interfaz) porque desde Android 12
          un BroadcastReceiver no puede lanzar actividades al pulsar una
          notificacion.
        -->
        <activity
            android:name=".NotificacionPulsadaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Botón "Más tarde" y aviso quitado de la bandeja. Solo lo llama la propia app. -->
        <receiver
            android:name=".avisos.AccionesAviso"
            android:exported="false" />
    </application>
</manifest>
