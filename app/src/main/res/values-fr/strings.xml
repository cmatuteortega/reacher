    <!-- Bienvenida -->
    <string name="bienvenida_sol_titulo">Tu es le soleil</string>
    <string name="bienvenida_sol_texto">Les personnes qui comptent pour toi gravitent autour de toi : c\'est ton système. Contacto te prévient quand il est temps d\'appeler ou d\'écrire à chacune, pour que personne ne s\'éloigne de ton orbite.</string>
