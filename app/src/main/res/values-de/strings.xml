    <!-- Bienvenida -->
    <string name="bienvenida_sol_titulo">Du bist die Sonne</string>
    <string name="bienvenida_sol_texto">Um dich kreisen die Menschen, die dir wichtig sind: Das ist dein System. Contacto erinnert dich, wenn es Zeit ist, jemanden anzurufen oder ihm zu schreiben, damit niemand aus deiner Umlaufbahn driftet.</string>
